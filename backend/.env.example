# ===================================================================
# FoodBridge Backend Environment Variables (.env.example)
# Team EcoConnect - Sri Lanka
# Copy this file to .env (or configure in your deployment platform, e.g. Render)
# ===================================================================

# Server Port
PORT=8080

# -------------------------------------------------------------------
# Supabase PostgreSQL Connection
# -------------------------------------------------------------------
# Option A: Full JDBC Connection URL (Recommended)
# Direct connection:
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Or Supabase Transaction Pooler (port 6543):
# DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# Option B: Individual connection components (used if DB_URL is not set)
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_SSL_MODE=require

# Hikari Connection Pool settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_INIT_FAIL_TIMEOUT=-1

# Hibernate DDL: 'update' for dev, 'validate' or 'none' for production
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# -------------------------------------------------------------------
# Security & JWT Configuration
# -------------------------------------------------------------------
# Generate a secure 256-bit key: openssl rand -base64 32
JWT_SECRET=your-minimum-256-bit-long-secret-key-for-foodbridge-jwt-authentication
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# Supabase API Credentials
# -------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# -------------------------------------------------------------------
# CORS Configuration (Comma-separated origins)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

