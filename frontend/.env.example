# ===================================================================
# FoodBridge Frontend Environment Variables (.env.example)
# Team EcoConnect - Sri Lanka
# Copy this file to .env or .env.local
# ===================================================================

# Backend REST API base URL
# Local development: http://localhost:8080/api
# Production on Render: https://foodbridge-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Supabase Client Configuration (Public Anon Key)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_SUPABASE_STORAGE_BUCKET=foodbridge-uploads

# Google Maps Platform Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Platform Branding
VITE_APP_NAME=FoodBridge
VITE_TEAM_NAME=EcoConnect

